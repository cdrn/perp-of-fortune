# Wallet whose Hyperliquid position we track (the agent/master address holding the position).
# Read-only — no private key here. Signing lives in sigil.
UNDERPOD_WALLET=0x0000000000000000000000000000000000000000

# Optional overrides
# UNDERPOD_PORT=4749
# UNDERPOD_HOST=127.0.0.1
# UNDERPOD_POLL_MS=5000
# UNDERPOD_DB=underpod.db
# HL_API=https://api.hyperliquid.xyz
# UNDERPOD_EPISODE=underpod-episode.json
# Existing legacy history? Use a new database for paired episodes:
# UNDERPOD_DB=paired-underpod.db

# Binary credentials do NOT belong in this dashboard file.
# Supply them only to the episode operator process: your secret manager/environment, or
# ${XDG_CONFIG_HOME:-~/.config}/perp-of-fortune/operator.env (0600; read only by scripts/episode.ts):
#   Kalshi (default venue):  KALSHI_API_KEY_ID + KALSHI_PRIVATE_KEY_FILE (path to the downloaded
#                            RSA .key PEM; or KALSHI_PRIVATE_KEY with the PEM text). Demo and
#                            production keys are separate; `--venue kalshi-demo` uses the demo API.
#   Polymarket US:           PM_US_API_KEY + PM_US_SECRET_KEY (Ed25519; international Polymarket
#                            wallet keys are incompatible).
